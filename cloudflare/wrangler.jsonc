{
  "name": "d2-mcp",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "send_metrics": false,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "d2.horv.co",
      "custom_domain": true
    }
  ],
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/site/*.html", "**/site/*.svg", "**/site/*.txt", "**/site/*.d2", "**/site/copy.js"],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": ["**/site/*.png"],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDERER",
        "class_name": "Renderer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Renderer"]
    }
  ],
  "compatibility_flags": [
    "enable_request_signal",
    "request_signal_passthrough"
  ],
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "PUBLIC_REQUESTS",
      "namespace_id": "20261015",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
