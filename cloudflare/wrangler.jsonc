{
  "name": "d2-mcp",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDERER",
        "class_name": "Renderer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Renderer"
      ]
    }
  ],
  "compatibility_flags": [
    "enable_request_signal",
    "request_signal_passthrough"
  ]
}
